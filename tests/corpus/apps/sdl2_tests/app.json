{
  "name": "sdl2_tests",
  "version": "2.30.9",
  "binary": "testautomation",
  "translate_flags": [
    "--stub-missing"
  ],
  "source": {
    "url": "https://github.com/libsdl-org/SDL/releases/download/release-2.30.9/SDL2-2.30.9.tar.gz",
    "sha256": "24b574f71c87a763f50704bbb630cbe38298d544a1f890f099a4696b1d6beba4"
  },
  "tests": [
    {
      "id": "platform",
      "args": [
        "--seed",
        "crossport",
        "--filter",
        "Platform"
      ],
      "stderr_keep": "(Test '.*': (Passed|Failed|Skipped)|Run Summary|Exit code)"
    },
    {
      "id": "rect",
      "args": [
        "--seed",
        "crossport",
        "--filter",
        "Rect"
      ],
      "stderr_keep": "(Test '.*': (Passed|Failed|Skipped)|Run Summary|Exit code)"
    },
    {
      "id": "pixels",
      "args": [
        "--seed",
        "crossport",
        "--filter",
        "Pixels"
      ],
      "stderr_keep": "(Test '.*': (Passed|Failed|Skipped)|Run Summary|Exit code)"
    },
    {
      "id": "surface",
      "args": [
        "--seed",
        "crossport",
        "--filter",
        "Surface"
      ],
      "stderr_keep": "(Test '.*': (Passed|Failed|Skipped)|Run Summary|Exit code)"
    },
    {
      "id": "render",
      "args": [
        "--seed",
        "crossport",
        "--filter",
        "Render"
      ],
      "stderr_keep": "(Test '.*': (Passed|Failed|Skipped)|Run Summary|Exit code)",
      "env": {
        "SDL_RENDER_DRIVER": "software"
      }
    },
    {
      "id": "video",
      "args": [
        "--seed",
        "crossport",
        "--filter",
        "Video"
      ],
      "stderr_keep": "(Test '.*': (Passed|Failed|Skipped)|Run Summary|Exit code)"
    },
    {
      "id": "keyboard",
      "args": [
        "--seed",
        "crossport",
        "--filter",
        "Keyboard"
      ],
      "stderr_keep": "(Test '.*': (Passed|Failed|Skipped)|Run Summary|Exit code)"
    },
    {
      "id": "events",
      "args": [
        "--seed",
        "crossport",
        "--filter",
        "Events"
      ],
      "stderr_keep": "(Test '.*': (Passed|Failed|Skipped)|Run Summary|Exit code)"
    }
  ]
}
