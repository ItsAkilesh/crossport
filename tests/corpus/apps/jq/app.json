{
  "name": "jq",
  "version": "1.7.1",
  "binary": "jq",
  "source": {
    "url": "https://github.com/jqlang/jq/releases/download/jq-1.7.1/jq-1.7.1.tar.gz",
    "sha256": "478c9ca129fd2e3443fe27314b455e211e0d8c60bc8ff7df703873deeee580c2"
  },
  "tests": [
    { "id": "version", "args": ["--version"] },
    { "id": "pretty-print", "args": ["."], "stdin": "inputs/sample.json" },
    { "id": "compact", "args": ["-c", "."], "stdin": "inputs/sample.json" },
    { "id": "select", "args": [".users[] | select(.age > 30) | .name"], "stdin": "inputs/sample.json" },
    { "id": "transform", "args": ["-c", ".users | map({name, next: (.age + 1)}) | sort_by(.name)"], "stdin": "inputs/sample.json" },
    { "id": "group-reduce", "args": ["-c", "[.users[] | {team, age}] | group_by(.team) | map({team: .[0].team, total: (map(.age) | add), n: length})"], "stdin": "inputs/sample.json" },
    { "id": "numbers", "args": ["-c", "[.numbers[], 1e1000, 3.0, 0.1, 1.5e-7, 123456789012345678901234567890, -0, 1/3]"], "stdin": "inputs/sample.json" },
    { "id": "string-functions", "args": ["-r", ".text | ascii_upcase, (split(\" \") | length), (gsub(\"o\"; \"0\")), @base64, @uri, @json"], "stdin": "inputs/sample.json" },
    { "id": "regex", "args": ["-c", ".text | [match(\"(\\\\w+) (\\\\w+)\").captures[].string, test(\"wor\"), (capture(\"(?<first>\\\\w+)\"))]"], "stdin": "inputs/sample.json" },
    { "id": "dates", "args": ["-n", "-c", "[(\"2015-03-05T23:51:47Z\" | fromdate), (1425599507 | todate), (1425599507 | strftime(\"%A %B %d %Y\")), (\"2015-03-05T23:51:47Z\" | strptime(\"%Y-%m-%dT%H:%M:%SZ\") | mktime)]"] },
    { "id": "arg-and-slurp", "args": ["-c", "--arg", "who", "world", "--slurp", "{who: $who, count: length, first: .[0]}"], "stdin": "inputs/stream.json" },
    { "id": "exit-status", "args": ["-e", ".missing"], "stdin": "inputs/sample.json" },
    { "id": "invalid-input", "args": ["."], "stdin": "inputs/broken.json" },
    { "id": "large-array", "args": ["-n", "[range(100000)] | map(. * 2) | add"] },
    { "id": "csv", "args": ["-r", ".users[] | [.name, .age, .team] | @csv"], "stdin": "inputs/sample.json" }
  ]
}
