{
  "name": "keepassxc",
  "version": "2.8.0",
  "binary": "keepassxc",
  "image": {
    "url": "https://github.com/keepassxreboot/keepassxc/releases/download/2.8.0/KeePassXC-2.8.0-x86_64.AppImage",
    "sha256": "b52889fd627ae7a1c609b91b2526ccd5d847ec6707ac6eb634553186dee4f705"
  },
  "convert": true,
  "translate_flags": [
    "--stub-missing",
    "--runtime",
    "build/runtime-pack"
  ],
  "tests": [
    {
      "id": "version",
      "args": [
        "--version"
      ],
      "timeout": 180,
      "stderr_keep": "(?!)"
    },
    {
      "id": "help",
      "args": [
        "--help"
      ],
      "timeout": 180,
      "stderr_keep": "(?!)"
    },
    {
      "id": "gui-start",
      "args": [],
      "timeout": 40,
      "stderr_keep": "(?!)",
      "env": {
        "QT_QPA_PLATFORM": "xcb"
      }
    }
  ]
}
